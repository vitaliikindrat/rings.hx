diff --git a/helix-view/src/overlays.rs b/helix-view/src/overlays.rs
new file mode 100644
index 0000000..17b7f09
--- /dev/null
+++ b/helix-view/src/overlays.rs
@@ -0,0 +1,142 @@
+//! Plugin-provided grapheme overlays: a plugin replaces the rendered grapheme
+//! at chosen char indices with its own text, styled by a theme scope. This is
+//! the mechanism jump labels use, exposed per scope so a plugin owns whole
+//! layers (e.g. one layer per indent-guide colour). Overlays are anchored by
+//! char index and follow edits.
+//!
+//! Inline layers are the same idea for virtual text *inserted* before a char
+//! index (what inlay hints use), styled by scope: they take up space, so they
+//! suit places with no grapheme to overlay, like the end of a blank line.
+
+use helix_core::text_annotations::{InlineAnnotation, Overlay};
+use helix_core::{Assoc, ChangeSet};
+
+#[derive(Debug, Default, Clone)]
+pub struct PluginOverlays {
+    /// (theme scope, overlays sorted by char_idx). Layers render in this
+    /// order and a later layer wins where two cover the same grapheme; a
+    /// scope keeps its slot when it is replaced.
+    layers: Vec<(String, Vec<Overlay>)>,
+    /// (theme scope, inline annotations sorted by char_idx), same ordering rules.
+    inline: Vec<(String, Vec<InlineAnnotation>)>,
+}
+
+impl PluginOverlays {
+    pub fn is_empty(&self) -> bool {
+        self.layers.iter().all(|(_, overlays)| overlays.is_empty())
+            && self.inline.iter().all(|(_, annotations)| annotations.is_empty())
+    }
+
+    pub fn layers(&self) -> impl Iterator<Item = (&str, &[Overlay])> {
+        self.layers
+            .iter()
+            .map(|(scope, overlays)| (scope.as_str(), overlays.as_slice()))
+    }
+
+    pub fn inline_layers(&self) -> impl Iterator<Item = (&str, &[InlineAnnotation])> {
+        self.inline
+            .iter()
+            .map(|(scope, annotations)| (scope.as_str(), annotations.as_slice()))
+    }
+
+    /// Replace the inline layer for `scope` with `text` inserted before each of
+    /// `positions`.
+    pub fn set_inline(&mut self, scope: &str, text: &str, mut positions: Vec<usize>) {
+        positions.sort_unstable();
+        let annotations = positions
+            .into_iter()
+            .map(|char_idx| InlineAnnotation::new(char_idx, text))
+            .collect();
+        match self.inline.iter_mut().find(|(s, _)| s == scope) {
+            Some((_, layer)) => *layer = annotations,
+            None => self.inline.push((scope.to_string(), annotations)),
+        }
+    }
+
+    /// Replace the layer for `scope` with `text` drawn at each of `positions`.
+    pub fn set(&mut self, scope: &str, text: &str, mut positions: Vec<usize>) {
+        positions.sort_unstable();
+        positions.dedup();
+        let overlays = positions
+            .into_iter()
+            .map(|char_idx| Overlay::new(char_idx, text))
+            .collect();
+        match self.layers.iter_mut().find(|(s, _)| s == scope) {
+            Some((_, layer)) => *layer = overlays,
+            None => self.layers.push((scope.to_string(), overlays)),
+        }
+    }
+
+    /// Drop both the overlay and the inline layer named `scope`.
+    pub fn clear(&mut self, scope: &str) {
+        self.layers.retain(|(s, _)| s != scope);
+        self.inline.retain(|(s, _)| s != scope);
+    }
+
+    pub fn clear_all(&mut self) {
+        self.layers.clear();
+        self.inline.clear();
+    }
+
+    pub fn map_changes(&mut self, changes: &ChangeSet) {
+        for (_, overlays) in &mut self.layers {
+            changes.update_positions(
+                overlays
+                    .iter_mut()
+                    .map(|overlay| (&mut overlay.char_idx, Assoc::After)),
+            );
+        }
+        for (_, annotations) in &mut self.inline {
+            changes.update_positions(
+                annotations
+                    .iter_mut()
+                    .map(|annotation| (&mut annotation.char_idx, Assoc::After)),
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use helix_core::{Rope, Selection, Transaction};
+
+    #[test]
+    fn layers_keep_their_slot_and_sort() {
+        let mut o = PluginOverlays::default();
+        o.set("a", "|", vec![5, 1, 5, 3]);
+        o.set("b", "|", vec![2]);
+        o.set("a", "!", vec![9]);
+        let layers: Vec<_> = o
+            .layers()
+            .map(|(s, l)| (s.to_string(), l.iter().map(|x| x.char_idx).collect::<Vec<_>>()))
+            .collect();
+        assert_eq!(layers, vec![("a".into(), vec![9]), ("b".into(), vec![2])]);
+        o.clear("a");
+        assert_eq!(o.layers().count(), 1);
+        o.clear_all();
+        assert!(o.is_empty());
+    }
+
+    #[test]
+    fn inline_layers_are_separate_and_cleared_with_their_scope() {
+        let mut o = PluginOverlays::default();
+        o.set("a", "|", vec![1]);
+        o.set_inline("a", "| ", vec![4, 4, 2]);
+        let inline: Vec<_> = o.inline_layers().map(|(_, l)| l.iter().map(|x| x.char_idx).collect::<Vec<_>>()).collect();
+        // duplicates are kept: several annotations may share a position
+        assert_eq!(inline, vec![vec![2, 4, 4]]);
+        o.clear("a");
+        assert!(o.is_empty());
+    }
+
+    #[test]
+    fn overlays_follow_edits() {
+        let rope = Rope::from("ab\n  cd\n");
+        let mut o = PluginOverlays::default();
+        o.set("g", "|", vec![3]);
+        let t = Transaction::insert(&rope, &Selection::point(0), "NEW\n".into());
+        o.map_changes(t.changes());
+        assert_eq!(o.layers().next().unwrap().1[0].char_idx, 7);
+    }
+}
