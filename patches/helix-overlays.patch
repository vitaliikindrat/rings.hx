+// "set-overlays!": replace the focused document's overlay layer `scope` with
+// `text` drawn over the grapheme at each char index in `positions`.
+pub fn set_overlays(cx: &mut Context, scope: SteelString, text: SteelString, positions: Vec<usize>) {
+    let (_, doc) = current!(cx.editor);
+    let len = doc.text().len_chars();
+    let positions = positions.into_iter().filter(|&p| p < len).collect();
+    doc.plugin_overlays.set(scope.as_str(), text.as_str(), positions);
+}
+
+// "set-inline-annotations!": replace the focused document's inline layer
+// `scope` with `text` inserted before each char index in `positions`.
+pub fn set_inline_annotations(
+    cx: &mut Context,
+    scope: SteelString,
+    text: SteelString,
+    positions: Vec<usize>,
+) {
+    let (_, doc) = current!(cx.editor);
+    let len = doc.text().len_chars();
+    let positions = positions.into_iter().filter(|&p| p <= len).collect();
+    doc.plugin_overlays.set_inline(scope.as_str(), text.as_str(), positions);
+}
+
+// "clear-overlays!": drop the focused document's overlay layer `scope`.
+pub fn clear_overlays(cx: &mut Context, scope: SteelString) {
+    let (_, doc) = current!(cx.editor);
+    doc.plugin_overlays.clear(scope.as_str());
+}
